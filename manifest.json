{
  "manifest_version": 3,
  "name": "CodeSync Pro",
  "version": "4.2.0",
  "description": "All-in-one Competitive Programming Workstation — syncs solutions to GitHub from Codeforces, AtCoder, CSES, LeetCode & Toph with dynamic Profile README stats cards, built-in IDE, testcase runner, and contest tracker.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "tabs",
    "offscreen",
    "sidePanel",
    "system.display"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://mirror.codeforces.com/*",
    "https://api.github.com/*",
    "https://atcoder.jp/*",
    "https://leetcode.com/*",
    "https://toph.co/*",
    "https://cses.fi/*",
    "https://kontests.net/*",
    "https://judge0-ce.p.rapidapi.com/*",
    "https://ce.judge0.com/*",
    "https://kenkoooo.com/*",
    "https://emkc.org/*",
    "https://api.paiza.io/*",
    "https://www.codechef.com/*",
    "https://www.hackerrank.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://mirror.codeforces.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://atcoder.jp/*"
      ],
      "js": [
        "content_ac.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content_lc.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://toph.co/*"
      ],
      "js": [
        "content_toph.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cses.fi/*"
      ],
      "js": [
        "content_cses.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CodeSync Pro"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "noti.mp3",
        "lib/monaco/*",
        "lib/monaco/*/*",
        "lib/monaco/*/*/*",
        "lib/monaco/*/*/*/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}